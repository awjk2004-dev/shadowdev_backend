# ===== App =====
APP_NAME=ShadowDev
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=development

# ===== Database (PostgreSQL / Supabase) =====
# Example: postgresql+psycopg://user:password@host:5432/database
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# ===== Security =====
# Generate a strong key, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_SECONDS=900

# ===== CORS (JSON list of allowed origins) =====
CORS_ORIGINS=["http://localhost:3000"]

# For production, set ENVIRONMENT=production, keep DEBUG=False, use a unique
# SECRET_KEY, and set CORS_ORIGINS to explicit HTTPS origins (or [] for Flutter-only APIs).
# Rate-limit and login-lockout state is process-local; use one worker/instance unless
# the limiter is moved to a shared store such as Redis.
# Enforce TLS at the server/reverse proxy. If proxied, trust forwarded headers only
# from known proxy IPs so client-supplied forwarding headers cannot spoof rate-limit IPs.
